---
import { Icon } from 'astro-icon/components';

interface Props {
    href: string,
    label?: string,
}

const {href, label} = Astro.props;

const isRedirect = href?.startsWith('https');
---
<a href={href} target={isRedirect ? '_blank' : '_self'} rel={isRedirect ? 'noopener noreferrer' : undefined} aria-label={label != '' ? label : undefined} class="inline-flex items-stretch overflow-hidden bg-accent/10 text-accent rounded-md">
    <span class="inline-flex items-center gap-2 px-5 py-3">
        <slot />
    </span>

    {
        isRedirect && (
            <span aria-hidden="true" class:list={['flex items-center px-3 bg-accent/5']}>
                <Icon name="bi:box-arrow-in-up-right" size=22 />
            </span>
        )
    }
</a>
