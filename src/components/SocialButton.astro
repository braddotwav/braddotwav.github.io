---
import { Icon } from 'astro-icon/components';
import { getWebsiteName } from '../utils/url';

interface Props {
    href: string
    size?: number
}

const { href, size = 24 } = Astro.props;

// Define a dictionary to store URL to icon string mappings
const urlIconMap: { [key: string]: string } = {
    'Github': 'bi:github',
    'Instagram': 'bi:instagram',
    'X': 'bi:twitter-x',
    'Spotify': 'bi:spotify',
    'Facebook': 'bi:facebook',
    'Soundcloud': 'bi:soundwave',
    'Youtube': 'bi:youtube'
};

// Function to get the relevant icon string from a URL
function getIconStringFromUrl(url: string) {
    const domainName = getWebsiteName(url);

    for (const [pattern, iconString] of Object.entries(urlIconMap)) {
        if (domainName.includes(pattern)) {
            return iconString;
        }
    }

    // If no matching pattern is found, return default icon string
    return 'bi:link-45deg';
}

---
<a href={href} aria-label={`braddotwav on ${getWebsiteName(href)}`} rel="noopener" target="_blank">
    <Icon name={getIconStringFromUrl(href)} size={size} class:list={"text-secondary transition-colors duration-200 hover:text-accent"} aria-hidden="true" focusable="false" />
</a>
